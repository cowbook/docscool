# DocsCool compose variables (copy this file to .env in project root)
# cp .env.compose.example .env

# Container names
DOCSCOOL_BACKEND_CONTAINER=contract-backend
DOCSCOOL_FRONTEND_CONTAINER=contract-frontend

# Host ports mapped to containers
DOCSCOOL_BACKEND_PORT=5000
DOCSCOOL_FRONTEND_PORT=8080

# NAS host path for contract storage bind mount
# Keep this path aligned with backend/.env -> CONTRACT_STORAGE_ROOT
DOCSCOOL_STORAGE_HOST_PATH=/volume1/contracts
