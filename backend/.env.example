# Flask runtime
FLASK_ENV=development
APP_SECRET_KEY=change-me-please
JWT_EXPIRES_HOURS=8

# SQLite database file
DATABASE_URL=sqlite:///instance/contracts.db

# Synology DSM endpoint (example: https://192.168.1.10:5001)
SYNOLOGY_BASE_URL=https://your-nas:5001
SYNOLOGY_AUTH_SESSION=DocsCool
SYNOLOGY_VERIFY_SSL=false

# Shared folder root path mounted on the backend host
# Example Linux: /volume1/contracts
# Example Windows test path: C:/contracts
CONTRACT_STORAGE_ROOT=/volume1/contracts

# Storage mode: local | remote
# local: save to local mounted path CONTRACT_STORAGE_ROOT
# remote: upload directly to Synology FileStation API
CONTRACT_STORAGE_MODE=remote

# Optional FileStation root path. If empty, auto-converted from CONTRACT_STORAGE_ROOT
# Example: /contracts 
SYNOLOGY_FILESTATION_ROOT=

# Required in remote mode
SYNOLOGY_UPLOAD_ACCOUNT=
SYNOLOGY_UPLOAD_PASSWORD=
SYNOLOGY_UPLOAD_SESSION=FileStation

# Minimax AI extraction config
MINIMAX_API_KEY=
MINIMAX_API_URL=https://api.minimaxi.com/v1/chat/completions
MINIMAX_MODEL=MiniMax-M2.5
MY_COMP=

# Xunfei OCR config
XUNFEI_APP_ID=
XUNFEI_API_KEY=
XUNFEI_API_URL=https://iocr.xfyun.cn/ocrzdq
XUNFEI_API_SECRET=